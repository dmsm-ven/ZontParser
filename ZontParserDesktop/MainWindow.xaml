<Window
    x:Class="ZontParserDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ZontParserDesktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <GroupBox Header="Парсинг">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="btnParseBrand"
                        Click="btnParseBrand_Click"
                        Content="Парсинг бренда"
                        IsEnabled="False" />
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <RadioButton
                            x:Name="chbxZont"
                            Margin="4"
                            Click="chbxBrand_Click"
                            GroupName="selected_brand">
                            Zont
                        </RadioButton>
                        <RadioButton
                            x:Name="chbxTeploluxNeptun"
                            Margin="4"
                            Click="chbxBrand_Click"
                            GroupName="selected_brand">
                            Теплолюкс (Нептун)
                        </RadioButton>
                        <RadioButton
                            x:Name="chbxMyHeat"
                            Margin="4"
                            Click="chbxBrand_Click"
                            GroupName="selected_brand">
                            MyHeat
                        </RadioButton>
                    </StackPanel>

                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="panelResources" Header="Ресурсы" IsEnabled="False">
                <StackPanel>
                    <Button
                        x:Name="btnDownloadResources"
                        Click="btnDownloadResources_Click"
                        Content="Скачать ресурсы" />
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="panelExport" Header="Экспорт" IsEnabled="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="2,2,8,2"
                            VerticalAlignment="Center"
                            Text="pid" />
                        <TextBox
                            x:Name="txtProductId"
                            Width="50"
                            Margin="2,2,8,2"
                            VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btnGeneralExport"
                            Click="btnGeneralExport_Click"
                            Content="Товары" />
                        <Button
                            x:Name="btnAdditionalImages"
                            Click="btnAdditionalImages_Click"
                            Content="Изображения" />
                        <Button
                            x:Name="btnGetDimensionsSql"
                            Click="btnGetDimensionsSql_Click"
                            Content="SQL Dimensions" />
                        <Button
                            x:Name="btnAdditionalImagesSql"
                            Click="btnAdditionalImagesSql_Click"
                            Content="SQL Images" />
                        <Button
                            x:Name="btnSqlDescription"
                            Click="btnSqlDescription_Click"
                            Content="SQL Description" />
                        <Button
                            x:Name="btnSqlPdf"
                            Click="btnSqlPdf_Click"
                            Content="SQL PDF" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" />

                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ProgressBar
            x:Name="pbIndicator"
            Grid.Row="1"
            Height="14"
            Margin="2"
            Maximum="1"
            Minimum="0"
            Value="0" />
    </Grid>
</Window>
